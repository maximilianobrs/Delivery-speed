<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="cl.speedfast.view.VentanaPrincipal">
  <grid id="27dc6" binding="panelVentanaPrincipal" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="15" vgap="15">
    <margin top="20" left="20" bottom="20" right="20"/>
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties/>
    <border type="none">
      <font/>
      <title-color color="-4473925"/>
    </border>
    <children>
      <grid id="3bf5e" layout-manager="GridLayoutManager" row-count="3" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false">
            <minimum-size width="150" height="40"/>
            <preferred-size width="300" height="200"/>
          </grid>
        </constraints>
        <properties>
          <enabled value="true"/>
        </properties>
        <border type="none"/>
        <children>
          <component id="42858" class="javax.swing.JButton" binding="registrarButton">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false">
                <minimum-size width="100" height="35"/>
                <preferred-size width="250" height="40"/>
              </grid>
            </constraints>
            <properties>
              <text value="Registrar pedido"/>
            </properties>
          </component>
          <component id="f04e6" class="javax.swing.JButton" binding="listarButton">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false">
                <minimum-size width="100" height="35"/>
                <preferred-size width="250" height="40"/>
              </grid>
            </constraints>
            <properties>
              <text value="Listar pedidos"/>
            </properties>
          </component>
          <component id="51705" class="javax.swing.JButton" binding="asignarButton">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false">
                <minimum-size width="100" height="35"/>
                <preferred-size width="250" height="40"/>
              </grid>
            </constraints>
            <properties>
              <text value="Asignar repartidor / Iniciar entrega"/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>
