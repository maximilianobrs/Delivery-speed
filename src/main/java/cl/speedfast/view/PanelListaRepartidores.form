<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="cl.speedfast.view.PanelListaRepartidores">
  <grid id="27dc6" binding="panelPrincipal" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="521" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="ae110" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="10" left="0" bottom="10" right="0"/>
        <constraints border-constraint="North"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="68e55" class="javax.swing.JLabel">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font size="20" style="1"/>
              <text value="Lista de repartidores"/>
            </properties>
          </component>
        </children>
      </grid>
      <grid id="aa748" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints border-constraint="Center"/>
        <properties/>
        <border type="none"/>
        <children>
          <scrollpane id="eb3a3">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false">
                <minimum-size width="400" height="150"/>
                <preferred-size width="700" height="300"/>
              </grid>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="305b5" class="javax.swing.JTable" binding="tablaRepartidores">
                <constraints/>
                <properties>
                  <rowMargin value="1"/>
                </properties>
              </component>
            </children>
          </scrollpane>
          <grid id="74d57" layout-manager="GridLayoutManager" row-count="1" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
            <margin top="10" left="0" bottom="10" right="0"/>
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="ac739" class="javax.swing.JButton" binding="btnRegistrar">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false">
                    <preferred-size width="160" height="40"/>
                  </grid>
                </constraints>
                <properties>
                  <background color="-10345473"/>
                  <focusPainted value="false"/>
                  <foreground color="-1"/>
                  <text value="Registrar"/>
                </properties>
              </component>
              <component id="77d0f" class="javax.swing.JButton" binding="btnActualizar">
                <constraints>
                  <grid row="0" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false">
                    <preferred-size width="160" height="40"/>
                  </grid>
                </constraints>
                <properties>
                  <background color="-10345473"/>
                  <foreground color="-1"/>
                  <text value="Actualizar"/>
                </properties>
              </component>
              <component id="8fd3e" class="javax.swing.JButton" binding="btnEditar">
                <constraints>
                  <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false">
                    <preferred-size width="160" height="40"/>
                  </grid>
                </constraints>
                <properties>
                  <background color="-10345473"/>
                  <focusPainted value="false"/>
                  <foreground color="-1"/>
                  <text value="Editar"/>
                </properties>
              </component>
              <component id="3dc7b" class="javax.swing.JButton" binding="btnEliminar">
                <constraints>
                  <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false">
                    <preferred-size width="160" height="40"/>
                  </grid>
                </constraints>
                <properties>
                  <background color="-3790808"/>
                  <contentAreaFilled value="true"/>
                  <focusPainted value="false"/>
                  <foreground color="-1"/>
                  <text value="Eliminar"/>
                </properties>
              </component>
            </children>
          </grid>
        </children>
      </grid>
    </children>
  </grid>
</form>
